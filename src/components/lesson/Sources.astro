---
// Sources at the bottom of a lesson step, from its `sources:` frontmatter: title and link only.
// Collapsed so they don't crowd the lesson, styled like <Discuss>.
import { BookMarked } from "lucide-react";
interface Props { sources: { title: string; url: string }[] }
const { sources } = Astro.props;
---

{sources.length > 0 && (
  <details data-step-sources class="group mt-12 rounded-xl border border-line bg-surface shadow-1">
    <summary class="flex min-h-[var(--tap)] cursor-pointer list-none items-center gap-3 rounded-xl px-4 py-3 sm:px-5 [&::-webkit-details-marker]:hidden">
      <BookMarked aria-hidden="true" className="size-5 shrink-0 text-brand" />
      <span class="flex-1">
        <span class="block font-bold text-ink">Sources</span>
        <span class="block text-small text-ink-soft">{sources.length === 1 ? "1 link" : `${sources.length} links`} behind the facts on this page</span>
      </span>
      <span aria-hidden="true" class="text-small font-bold text-brand group-open:hidden">Show</span>
      <span aria-hidden="true" class="hidden text-small font-bold text-brand group-open:inline">Hide</span>
    </summary>
    <ol class="list-decimal space-y-2 border-t border-line py-4 pl-10 pr-4 text-ui sm:pr-5 [&_li::marker]:text-ink-soft">
      {sources.map((s) => (
        <li><a href={s.url} class="break-words font-bold text-brand underline decoration-1 underline-offset-4 hover:decoration-2">{s.title}</a></li>
      ))}
    </ol>
  </details>
)}
