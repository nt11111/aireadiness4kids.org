---
// A section's small label and heading, on the 12-column grid: label in the first 3 columns, heading in the rest.
interface Props { id: string; label: string; title: string; class?: string }
const { id, label, title, class: className } = Astro.props;
---

<div class:list={["mb-8 grid gap-2.5 md:grid-cols-12 md:items-end md:gap-6", className]}>
  <p class="font-display text-small font-bold text-ink-soft md:col-span-3">{label}</p>
  <h2 id={id} class="text-[clamp(1.625rem,3vw,2.25rem)] leading-tight text-ink md:col-span-9">{title}</h2>
</div>
