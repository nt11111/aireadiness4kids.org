---
// One syllabus row on a course page: a native <details> disclosure, so it works without JavaScript.
import { ArrowRight, ChevronDown, Clock } from "lucide-react";
import StepList from "./StepList.astro";
import { ReviewBadge } from "../app/components/site/ReviewBadge";
import { ModuleRowProgress } from "../app/components/lesson/CourseProgress";
import { trackStyle } from "../app/lib/tracks";
import { cn } from "../app/components/ui/utils";
import { moduleHref, moduleTime, type Module, type Step } from "../lib/courses";

interface Props { mod: Module; steps: Step[]; open?: boolean }
const { mod, steps, open = false } = Astro.props;
const { title, order, summary, status, reviewers, track } = mod.data;
const s = trackStyle(track);
---

<details class="group rounded-lg border border-line bg-surface shadow-1 transition-shadow duration-[var(--dur)] open:shadow-2" open={open}>
  <summary class="flex cursor-pointer list-none items-start gap-4 rounded-lg p-4 transition-colors duration-[var(--dur)] hover:bg-surface-2/60 sm:items-center sm:p-5 [&::-webkit-details-marker]:hidden">
    <span class={cn("grid size-10 shrink-0 place-items-center rounded-full font-display text-title font-semibold sm:size-11", s.fill)} aria-hidden="true">{order}</span>
    <span class="min-w-0 flex-1">
      <span class="sr-only">Module {order}: </span>
      <span class="block font-display text-title font-semibold text-ink">{title}</span>
      <span class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-2 text-small text-ink-soft">
        <span class="inline-flex items-center gap-1.5"><Clock aria-hidden="true" className="size-4" />{moduleTime(mod, steps)}</span>
        {steps.length > 0 && <ModuleRowProgress client:idle steps={steps.map((s) => ({ id: s.id, href: s.href }))} />}
        <ReviewBadge status={status} reviewers={reviewers} />
      </span>
    </span>
    <ChevronDown aria-hidden="true" className="mt-2 size-5 shrink-0 text-ink-soft transition-transform duration-[var(--dur)] group-open:rotate-180 sm:mt-0" />
  </summary>
  <div class="border-t border-line px-4 pb-5 pt-4 sm:px-5 sm:pl-[5rem]">
    <p class="text-ui text-ink">{summary}</p>
    <StepList steps={steps} tone="plain" class="mt-3" />
    <a href={moduleHref(mod)} aria-label={`Module overview: ${title}`} class="mt-4 inline-flex items-center gap-1.5 rounded-sm text-ui font-bold text-brand underline decoration-1 underline-offset-4 hover:decoration-2">
      Module overview
      <ArrowRight aria-hidden="true" className="size-4" />
    </a>
  </div>
</details>
