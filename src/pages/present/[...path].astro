---
// /present/[track]/[module] (brief section 7): facilitators and admins only, checked in middleware and
// again here. Phase 5 builds presenter mode.
import BaseLayout from "../../layouts/BaseLayout.astro";
export const prerender = false;

const role = Astro.locals.user?.role;
if (role !== "facilitator" && role !== "admin") return Astro.rewrite("/forbidden");
---

<BaseLayout title="Presenter mode | ARK" noindex>
  <div class="px-4 pb-20 pt-28 sm:px-6 lg:pt-36">
    <div class="mx-auto max-w-reading">
      <h1 class="text-display-lg text-ink">Presenter mode</h1>
      <p class="mt-3 text-lesson text-ink-soft">Full-screen presenting with QR codes for workshop checks arrives in Phase 5.</p>
    </div>
  </div>
</BaseLayout>
