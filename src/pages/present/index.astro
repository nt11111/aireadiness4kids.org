---
// /present: the modules a facilitator can present (the ones with lesson steps). Facilitators and
// admins only (middleware, and again below).
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Badge } from "../../app/components/ui/badge";
import { buttonVariants } from "../../app/components/ui/button";
import type { TrackId } from "../../app/lib/tracks";
import { getCourses, getModuleSteps, moduleSlug } from "../../lib/courses";
import { Presentation } from "lucide-react";
export const prerender = false;

const role = Astro.locals.user?.role;
if (role !== "facilitator" && role !== "admin") return Astro.rewrite("/forbidden");
const ready = (await getCourses()).flatMap((course) =>
  course.modules.filter((m) => getModuleSteps(course, m).length > 0).map((m) => ({ course, mod: m, steps: getModuleSteps(course, m).length })),
);
---

<BaseLayout title="Presenter mode | ARK" noindex>
  <div class="px-4 pb-20 pt-28 sm:px-6 lg:pt-36">
    <div class="mx-auto max-w-site">
      <h1 class="text-display-lg text-ink">Presenter mode</h1>
      <p class="mt-3 max-w-reading text-lesson text-ink-soft">Project a module one step at a time. Use the arrow keys (or a clicker) to move, and F for full screen. Check steps show a QR code so the room can answer on their phones, with no account.</p>
      <p class="mt-3 max-w-reading text-ui text-ink-soft">Presenting at a workshop? Add its tag on the first slide (or to the link, like <code class="rounded bg-surface-2 px-1.5 py-0.5 text-small">?src=uys-fall26</code>) so the answers count toward it on the admin page.</p>
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {ready.map(({ course, mod, steps }) => (
          <li class="flex flex-col gap-4 rounded-xl border border-line bg-surface p-5 shadow-1 sm:flex-row sm:items-center">
            <div class="min-w-0 flex-1">
              <Badge variant={course.track.id as TrackId}>{course.track.data.title}</Badge>
              <p class="mt-2 font-display text-title font-semibold text-ink">{mod.data.title}</p>
              <p class="text-small text-ink-soft">{steps} steps</p>
            </div>
            <a href={`/present/${course.track.id}/${moduleSlug(mod)}`} class={buttonVariants()}><Presentation aria-hidden="true" />Present<span class="sr-only"> {mod.data.title}</span></a>
          </li>
        ))}
      </ul>
      {ready.length === 0 && <p class="mt-8 text-ui text-ink-soft">No modules have lesson steps yet.</p>}
      <p class="mt-8 text-ui text-ink-soft">Other modules can be presented from their slide decks until their lessons are written. <a href="/educators" class="font-bold text-brand underline underline-offset-4">Facilitator guides</a></p>
    </div>
  </div>
</BaseLayout>
