---
// /admin (brief section 7): admins only, checked in middleware and again here. Phase 5 builds the dashboard.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { db } from "../../lib/firebase-admin";
export const prerender = false;

if (Astro.locals.user?.role !== "admin") return Astro.rewrite("/forbidden");
const snap = await db().doc("stats/global").get();
const totals = Object.entries(snap.exists ? (snap.data() ?? {}) : {}).filter(([, v]) => typeof v === "number");
---

<BaseLayout title="Admin | ARK" noindex>
  <div class="px-4 pb-20 pt-28 sm:px-6 lg:pt-36">
    <div class="mx-auto max-w-site">
      <h1 class="text-display-lg text-ink">Admin</h1>
      <p class="mt-3 max-w-reading text-lesson text-ink-soft">Impact numbers, filters, and CSV export arrive in Phase 5. This page only ever shows totals, never individual learners.</p>
      {totals.length > 0 ? (
        <dl class="mt-8 grid gap-4 sm:grid-cols-3">
          {totals.map(([k, v]) => (
            <div class="flex flex-col rounded-xl border border-line bg-surface p-5 shadow-1"><dt class="text-small text-ink-soft">{k}</dt><dd class="order-first font-display text-display-sm text-ink">{v}</dd></div>
          ))}
        </dl>
      ) : (
        <p class="mt-8 text-ui text-ink-soft">No totals recorded yet.</p>
      )}
    </div>
  </div>
</BaseLayout>
