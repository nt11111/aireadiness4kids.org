---
// /admin (brief section 7): ARK's impact numbers. Admins only, checked in middleware and again here.
// Every number is a running total from the stats docs (src/lib/impact.ts), filtered by workshop or
// partner tag (?source=) and date range; no individual learner's data is read or shown.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buttonVariants } from "../../app/components/ui/button";
import { COUNTERS, filterFrom, impactReport } from "../../lib/impact";
import { Download } from "lucide-react";
export const prerender = false;

if (Astro.locals.user?.role !== "admin") return Astro.rewrite("/forbidden");
const report = await impactReport(filterFrom(Astro.url.searchParams));
const { filter, totals, modules, sources } = report;
const query = new URLSearchParams(Object.entries(filter).filter((e): e is [string, string] => Boolean(e[1]))).toString();
const pct = (v: number | null) => (v === null ? "No results" : `${v}%`);
const pts = (v: number | null) => (v === null ? "" : v > 0 ? `+${v} pts` : `${v} pts`);
const srcLabel = (s: string) => (s === "_none" ? "(no tag)" : s);
const scope = [
  filter.source ? `tag ${srcLabel(filter.source)}` : "all tags",
  filter.from || filter.to ? `${filter.from ?? "the start"} to ${filter.to ?? "today"} (UTC)` : "all time",
].join(", ");
const today = new Date().toISOString().slice(0, 10);
// A date input's calendar button is inside the input, where :focus-visible doesn't reach, so the ring uses :focus-within.
const field = "h-11 rounded-lg border border-input bg-surface px-3 text-ui text-ink focus-within:outline-3 focus-within:outline-offset-3 focus-within:outline-ring focus-within:outline-solid";
---

<BaseLayout title="Admin | ARK" noindex>
  <div class="px-4 pb-20 pt-28 sm:px-6 lg:pt-36">
    <div class="mx-auto max-w-site">
      <h1 class="text-display-lg text-ink">Impact numbers</h1>
      <p class="mt-3 max-w-reading text-lesson text-ink-soft">Running totals across everyone who uses ARK. This page never shows individual learners.</p>

      <!-- A plain GET form on purpose: the filters are not sensitive, and the result is a shareable URL. -->
      <form method="get" action="/admin" class="mt-8 flex flex-wrap items-end gap-4 rounded-xl border border-line bg-surface p-5 shadow-1" aria-label="Filter the numbers">
        <label class="grid gap-1.5 text-small font-bold text-ink">
          Workshop or partner tag
          <select name="source" class={field}>
            <option value="">All tags</option>
            {sources.map((s) => <option value={s} selected={filter.source === s}>{srcLabel(s)}</option>)}
          </select>
        </label>
        <label class="grid gap-1.5 text-small font-bold text-ink">
          From
          <input type="date" name="from" value={filter.from ?? ""} max={today} class={field} />
        </label>
        <label class="grid gap-1.5 text-small font-bold text-ink">
          To
          <input type="date" name="to" value={filter.to ?? ""} max={today} class={field} />
        </label>
        <button type="submit" class={buttonVariants()}>Apply</button>
        {query && <a href="/admin" class={buttonVariants({ variant: "ghost" })}>Clear filters</a>}
        <a href={`/api/admin/stats.csv${query ? `?${query}` : ""}`} class={buttonVariants({ variant: "outline", className: "sm:ml-auto" })} download><Download aria-hidden="true" />Download CSV</a>
      </form>
      <p class="mt-3 text-small text-ink-soft" data-admin-scope>Showing {scope}{report.days !== null && `, ${report.days} day${report.days === 1 ? "" : "s"} with activity`}. Dates are when each thing happened, in UTC.</p>

      <section aria-labelledby="totals-h" class="mt-10">
        <h2 id="totals-h" class="text-display-sm text-ink">Totals</h2>
        <dl class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-admin-totals>
          {COUNTERS.map((c) => (
            <div class="flex flex-col rounded-xl border border-line bg-surface p-5 shadow-1" data-metric={c.key}>
              <dt class="text-small text-ink-soft">{c.label}</dt>
              <dd class="order-first font-display text-display-sm tabular-nums text-ink">{totals[c.key].toLocaleString("en-US")}</dd>
            </div>
          ))}
          <div class="flex flex-col rounded-xl border border-line bg-surface p-5 shadow-1" data-metric="pre-avg">
            <dt class="text-small text-ink-soft">Before checks, average correct ({totals.preCount.toLocaleString("en-US")} results)</dt>
            <dd class="order-first font-display text-display-sm tabular-nums text-ink">{pct(report.preAvg)}</dd>
          </div>
          <div class="flex flex-col rounded-xl border border-line bg-surface p-5 shadow-1" data-metric="post-avg">
            <dt class="text-small text-ink-soft">After checks, average correct ({totals.postCount.toLocaleString("en-US")} results)</dt>
            <dd class="order-first font-display text-display-sm tabular-nums text-ink">{pct(report.postAvg)}</dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="modules-h" class="mt-12">
        <h2 id="modules-h" class="text-display-sm text-ink">By module</h2>
        <p class="mt-2 max-w-reading text-small text-ink-soft">Before and after checks come from the optional checks in each module and from workshop QR checks. They aren't always the same people, so treat the change as a signal, not a controlled result.</p>
        {modules.length ? (
          <div class="mt-5 overflow-x-auto rounded-xl border border-line bg-surface shadow-1" tabindex="0" role="region" aria-labelledby="modules-h">
            <table class="w-full min-w-[46rem] text-left text-ui" data-admin-modules>
              <thead class="border-b border-line bg-surface-2 text-small text-ink-soft">
                <tr>
                  <th scope="col" class="px-4 py-3 font-bold">Module</th>
                  <th scope="col" class="px-4 py-3 text-right font-bold">Starts</th>
                  <th scope="col" class="px-4 py-3 text-right font-bold">Completions</th>
                  <th scope="col" class="px-4 py-3 text-right font-bold">Before (results)</th>
                  <th scope="col" class="px-4 py-3 text-right font-bold">After (results)</th>
                  <th scope="col" class="px-4 py-3 text-right font-bold">Change</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                {modules.map((m) => (
                  <tr>
                    <th scope="row" class="px-4 py-3 font-bold text-ink">{m.title}<span class="block text-small font-normal capitalize text-ink-soft">{m.track}</span></th>
                    <td class="px-4 py-3 text-right tabular-nums">{m.starts}</td>
                    <td class="px-4 py-3 text-right tabular-nums">{m.completions}</td>
                    <td class="px-4 py-3 text-right tabular-nums">{pct(m.preAvg)} <span class="text-ink-soft">({m.preCount})</span></td>
                    <td class="px-4 py-3 text-right tabular-nums">{pct(m.postAvg)} <span class="text-ink-soft">({m.postCount})</span></td>
                    <td class="px-4 py-3 text-right font-bold tabular-nums">{pts(m.change)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="mt-5 text-ui text-ink-soft">No module activity for this filter yet.</p>
        )}
      </section>
    </div>
  </div>
</BaseLayout>
