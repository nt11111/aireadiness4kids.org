---
// Public certificate check (brief sections 4 and 8.2): /verify/{certId}. Shows only the display name,
// the module, and the date, and only for public certificates (13+ learners). Private (under-13),
// deleted, and made-up ids all get the same "not found".
import BaseLayout from "../../layouts/BaseLayout.astro";
import { certificateDate, publicCertificate } from "../../lib/certificates";
import { getCourses, moduleHref } from "../../lib/courses";
import { buttonVariants } from "../../app/components/ui/button";
import { BadgeCheck, SearchX } from "lucide-react";
export const prerender = false;

const cert = await publicCertificate(Astro.params.id ?? "");
const course = cert ? (await getCourses()).find((c) => c.modules.some((m) => m.id === cert.moduleId)) : undefined;
const mod = course?.modules.find((m) => m.id === cert?.moduleId);
const found = Boolean(cert && course && mod);
if (!found) Astro.response.status = 404;
---

<BaseLayout title={found ? "Certificate verified | ARK" : "Certificate not found | ARK"} noindex>
  <div class="px-4 pb-20 pt-28 sm:px-6 lg:pt-36">
    <div class="mx-auto max-w-reading">
      {found && cert && course && mod ? (
        <div class="rounded-xl border border-brand/30 bg-surface p-6 shadow-1 sm:p-8" data-verified>
          <p class="inline-flex items-center gap-2 text-ui font-bold text-success"><BadgeCheck aria-hidden="true" className="size-6" />Verified by ARK</p>
          <h1 class="mt-3 text-display-md text-ink sm:text-display-lg">{cert.displayName}</h1>
          <p class="mt-3 text-lesson text-ink">completed the module <a href={moduleHref(mod)} class="font-bold text-brand underline underline-offset-4">{mod.data.title}</a> in {course.track.data.title} (grades {course.track.data.grades}).</p>
          <dl class="mt-6 grid gap-4 border-t border-line pt-5 text-ui sm:grid-cols-2">
            <div><dt class="font-bold text-ink-soft">Issued</dt><dd class="text-ink">{certificateDate(cert.issuedAt)}</dd></div>
            <div><dt class="font-bold text-ink-soft">Certificate ID</dt><dd class="break-all font-mono text-small text-ink">{cert.id}</dd></div>
          </dl>
          <p class="mt-6 text-small text-ink-soft">ARK (AI Readiness for Kids) is a nonprofit that offers free AI literacy lessons for K-12 learners. This page confirms that ARK issued this certificate.</p>
        </div>
      ) : (
        <div class="rounded-xl border border-line bg-surface p-6 shadow-1 sm:p-8" data-not-found>
          <p class="inline-flex items-center gap-2 text-ui font-bold text-ink-soft"><SearchX aria-hidden="true" className="size-6" />Not found</p>
          <h1 class="mt-3 text-display-md text-ink">We couldn't find that certificate</h1>
          <p class="mt-3 text-lesson text-ink-soft">Check that the link was copied in full. Certificates earned by learners under 13 are private, so they can't be checked here.</p>
          <a href="/courses" class={buttonVariants({ className: "mt-6" })}>Browse ARK's free courses</a>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
