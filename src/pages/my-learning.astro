---
// /my-learning (brief section 7): modules in progress with a "Continue" button, finished modules,
// and for parent accounts, whose profile this is with a switcher. Rendered on the server from the
// active learner's Firestore progress, so it works without JavaScript (only the switcher needs it).
import BaseLayout from "../layouts/BaseLayout.astro";
import { LearnerSwitcher } from "../app/components/account/LearnerSwitcher";
import { ProgressRing } from "../app/components/ui/progress-ring";
import { buttonVariants } from "../app/components/ui/button";
import { cn } from "../app/components/ui/utils";
import { getProfile } from "../lib/accounts";
import { activeLearner, learnerProgress } from "../lib/learning";
import { learnerCertificates } from "../lib/certificates";
import { getCourses, getModuleSteps, moduleHref } from "../lib/courses";
import { ArrowRight, Award, CircleCheck } from "lucide-react";
export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect(`/signin?next=${encodeURIComponent("/my-learning")}`, 302);
const profile = await getProfile(user.uid);
if (!profile) return Astro.redirect("/signup", 302);
const parent = profile.accountType === "parent";
const { learner, learners } = await activeLearner(user.uid, Astro.cookies);
// Progress is saved to a learner profile, so a parent without one adds it first.
if (parent && learners.length === 0) return Astro.redirect(`/account/add-learner?next=${encodeURIComponent("/my-learning")}`, 302);
const [progress, certificates]: [Awaited<ReturnType<typeof learnerProgress>>, Awaited<ReturnType<typeof learnerCertificates>>] = learner
  ? await Promise.all([learnerProgress(user.uid, learner.id), learnerCertificates(user.uid, learner.id)])
  : [{}, new Map()];

type Row = { id: string; title: string; href: string; track: "aware" | "literate" | "fluent"; trackTitle: string; done: number; total: number; next: { href: string; n: number; title: string } | null; at: string };
const rows: Row[] = [];
for (const course of await getCourses()) {
  for (const mod of course.modules) {
    const p = progress[mod.id];
    const steps = getModuleSteps(course, mod);
    if (!p || !steps.length) continue;
    const doneSet = new Set(p.steps);
    const done = steps.filter((s) => doneSet.has(s.slug)).length;
    if (done === 0) continue;
    const next = steps.find((s) => !doneSet.has(s.slug));
    rows.push({
      id: mod.id,
      title: mod.data.title,
      href: moduleHref(mod),
      track: course.track.id as Row["track"],
      trackTitle: course.track.data.title,
      done,
      total: steps.length,
      next: next ? { href: next.href, n: next.n, title: next.title } : null,
      at: (next ? p.updatedAt : (p.completedAt ?? p.updatedAt)) ?? "",
    });
  }
}
const inProgress = rows.filter((r) => r.next).sort((a, b) => b.at.localeCompare(a.at));
const finished = rows.filter((r) => !r.next).sort((a, b) => b.at.localeCompare(a.at));
const day = (iso: string) => (iso ? new Date(iso).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }) : "");
const who = parent ? learner?.nickname : null;
---

<BaseLayout title="My learning | ARK · AI Readiness for Kids" noindex>
  <div class="px-4 pb-20 pt-28 sm:px-6 lg:pt-36" data-server-progress>
    <div class="mx-auto max-w-site">
      <h1 class="text-display-lg text-ink">{who ? `${who}'s learning` : `Hi, ${profile.displayName}`}</h1>
      {parent && learners.length > 0 && (
        <div class="mt-6 max-w-3xl">
          <LearnerSwitcher client:load learners={learners.map((l) => ({ id: l.id, nickname: l.nickname }))} activeId={learner?.id ?? null} />
          <p class="mt-3 text-small text-ink-soft">Each profile keeps its own progress. <a href="/account#learners" class="font-bold text-brand underline underline-offset-4">Manage profiles</a></p>
        </div>
      )}

      <section aria-labelledby="continue-h" class="mt-10">
        <h2 id="continue-h" class="text-display-sm text-ink">Continue</h2>
        {inProgress.length ? (
          <ul class="mt-5 grid gap-4 lg:grid-cols-2">
            {inProgress.map((r) => (
              <li class="flex flex-col gap-4 rounded-xl border border-line bg-surface p-5 shadow-1 sm:flex-row sm:items-center sm:p-6">
                <ProgressRing done={r.done} total={r.total} label={`${r.title}: steps done`} track={r.track} />
                <div class="min-w-0 flex-1">
                  <p class="text-small font-bold text-ink-soft">{r.trackTitle}</p>
                  <h3 class="mt-0.5 font-display text-title font-semibold text-ink"><a href={r.href} class="rounded-sm underline decoration-line-strong decoration-1 underline-offset-4 hover:text-brand hover:decoration-brand">{r.title}</a></h3>
                  <p class="mt-1 text-small text-ink-soft">{r.done} of {r.total} steps done · Next: step {r.next!.n}, {r.next!.title}</p>
                </div>
                <a href={r.next!.href} class={cn(buttonVariants(), "self-start sm:self-center")}>Continue<span class="sr-only"> {r.title}</span> <ArrowRight aria-hidden="true" /></a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="mt-5 max-w-reading rounded-xl border border-line bg-surface p-6 shadow-1">
            <p class="text-lesson text-ink">{finished.length ? "Nothing in progress right now. Pick your next module and keep going." : "You haven't started a module yet. Pick a course and your progress will show up here."}</p>
            <a href="/courses" class={buttonVariants({ className: "mt-5" })}>Browse courses <ArrowRight aria-hidden="true" /></a>
          </div>
        )}
      </section>

      {finished.length > 0 && (
        <section aria-labelledby="done-h" class="mt-12">
          <h2 id="done-h" class="text-display-sm text-ink">Finished</h2>
          <ul class="mt-5 grid gap-3 lg:grid-cols-2">
            {finished.map((r) => (
              <li class="flex flex-wrap items-center gap-4 rounded-xl border border-line bg-surface p-5 shadow-1">
                <CircleCheck aria-hidden="true" className="size-8 shrink-0 text-success" />
                <div class="min-w-0 flex-1">
                  <h3 class="font-display text-title font-semibold text-ink"><a href={r.href} class="rounded-sm underline decoration-line-strong decoration-1 underline-offset-4 hover:text-brand hover:decoration-brand">{r.title}</a></h3>
                  <p class="text-small text-ink-soft">{r.trackTitle}{r.at && ` · Finished ${day(r.at)}`}</p>
                </div>
                {certificates.has(r.id) ? (
                  <a href={`/certificates/${certificates.get(r.id)!.id}`} class={buttonVariants({ variant: "outline", size: "sm", className: "min-h-11" })}><Award aria-hidden="true" />Reprint certificate<span class="sr-only"> for {r.title}</span></a>
                ) : (
                  <a href={`${r.href}/complete`} class={buttonVariants({ variant: "outline", size: "sm", className: "min-h-11" })}><Award aria-hidden="true" />Get certificate<span class="sr-only"> for {r.title}</span></a>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}
      <a href="/courses" class={buttonVariants({ variant: "outline", className: "mt-10" })}>Browse courses</a>
    </div>
  </div>
</BaseLayout>
