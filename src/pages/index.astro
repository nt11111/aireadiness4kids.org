---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";
import HeroHull from "../components/HeroHull.astro";
import CredibilityStrip from "../components/CredibilityStrip.astro";
import ImpactNumbers from "../components/ImpactNumbers.astro";
import { buttonVariants } from "../app/components/ui/button";
import { ContinueCard } from "../app/components/lesson/CourseProgress";
import { SampleQuestion } from "../app/components/home/SampleQuestion";
import { AMBASSADOR_HREF } from "../app/components/site/Nav";
import { trackStyle } from "../app/lib/tracks";
import { cn } from "../app/components/ui/utils";
import { getCourses, getModuleSteps, getReviewers, moduleLite, trackHref } from "../lib/courses";
export const prerender = true;

const courses = await getCourses();
const reviewers = getReviewers(courses);
// Only modules with lesson steps can be "in progress".
const started = courses.flatMap((c) => c.modules.map((m) => moduleLite(c, m))).filter((m) => m.steps.length > 0);

// "Try a real question": the first three cards of AI Aware's "How AI learns" sort (step 2, open to everyone).
const aware = courses.find((c) => c.track.id === "aware");
const whatIsAi = aware?.modules.find((m) => m.id.endsWith("what-is-ai"));
const sampleStep = aware && whatIsAi ? getModuleSteps(aware, whatIsAi).find((s) => s.entry.data.sort) : undefined;
const sample = sampleStep?.entry.data.sort;

const trust = [
  { bar: "bg-track-fluent", title: "Reviewed by experts", body: "An educator and an AI professional review each module.", link: ["How review works", "/about#reviewers"] },
  { bar: "bg-track-aware", title: "Free, with no ads", body: "Every course, always. ARK is a nonprofit." },
  { bar: "bg-track-literate", title: "Kids stay private", body: "Under 13? No email, just a nickname a grown-up sets up." },
  { bar: "bg-ink", title: "Home or classroom", body: "Read-aloud for young kids, guides and slides for teachers." },
];

const ambassador = [
  ["1 day", "Certification training", "Learn to run a session with confidence."],
  ["1 workshop", "Each semester", "At your own school, or in your community."],
  ["Credit", "Recognition for your work", "A letter of recognition, and credit on content you help write."],
];
---

<BaseLayout title="ARK | Free AI lessons for K-12 learners" description="Short, free AI lessons for grades K-12 from ARK (AI Readiness Kollective), a nonprofit. Three courses for grades K-5, 6-8, and 9-12. Always free.">
  <section aria-labelledby="hero-h" class="px-4 pb-16 pt-28 sm:px-6 sm:pb-20 lg:pb-24 lg:pt-36">
    <div class="mx-auto grid max-w-site items-center gap-10 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-7">
        <h1 id="hero-h" class="max-w-[22ch] text-[clamp(1.875rem,4vw,2.875rem)] leading-[1.15] text-ink">Help kids understand the AI they already use.</h1>
        <p class="mt-4 max-w-[36em] text-[1.125rem] text-ink-soft sm:text-[1.25rem]">Short, free lessons for grades K-12, reviewed by an educator and an AI professional. No account needed for the first steps.</p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a href="/courses" class={cn(buttonVariants({ size: "lg" }), "justify-between gap-6")}>See the courses <span aria-hidden="true">→</span></a>
          {sample && <a href="#sample" class={buttonVariants({ variant: "outline", size: "lg" })}>Try a sample question</a>}
        </div>
        <p class="mt-5 text-ui text-ink-soft">Grown-ups: <a href="/parents" class="font-bold text-ink underline underline-offset-4">for parents</a> · <a href="/educators" class="font-bold text-ink underline underline-offset-4">for teachers</a></p>
      </div>
      <HeroHull class="mx-auto max-w-[280px] sm:max-w-[360px] lg:col-span-5 lg:col-start-8 lg:max-w-[460px]" />
    </div>
  </section>

  <!-- Signed-in learners with progress only (brief section 7); renders nothing for everyone else. -->
  <ContinueCard client:idle modules={started} />

  {sample && sampleStep && whatIsAi && (
    <section id="sample" aria-labelledby="sample-h" class="border-t border-line bg-surface-2 px-4 py-14 sm:px-6 lg:py-20">
      <div class="mx-auto max-w-site">
        <SectionHead id="sample-h" label="What a lesson looks like" title="Try a real question." />
        <div class="grid gap-6 lg:grid-cols-12">
          <p class="text-ui text-ink-soft lg:col-span-4">From “{whatIsAi.data.title}”, the first module of AI Aware. Pick an answer, then press Check.</p>
          <div class="lg:col-span-7 lg:col-start-6">
            <SampleQuestion client:visible sort={{ ...sample, items: sample.items.slice(0, 3) }} lessonHref={sampleStep.href} lessonTitle={sampleStep.title} />
          </div>
        </div>
      </div>
    </section>
  )}

  <section aria-labelledby="courses-h" class="border-t border-line px-4 py-14 sm:px-6 lg:py-20">
    <div class="mx-auto max-w-site">
      <SectionHead id="courses-h" label="Courses" title="One course for each age group." />
      <ul class="border-t-2 border-ink">
        {courses.map(({ track }) => (
          <li>
            <a href={trackHref(track)} class="group grid min-h-[72px] grid-cols-[6px_56px_1fr] items-center gap-x-3.5 border-b border-line py-3.5 transition-colors hover:bg-surface-2 sm:grid-cols-[8px_88px_1fr_auto] sm:gap-x-5">
              <span class={cn("self-stretch", trackStyle(track.id).bar)} aria-hidden="true"></span>
              <span class="font-display text-lg font-bold text-ink-soft sm:text-[1.375rem]"><span class="sr-only">Grades </span>{track.data.grades.replace("-", "–")}</span>
              <span>
                <span class="block font-display text-lg font-bold text-ink sm:text-xl">{track.data.title}</span>
                <span class="block text-ui text-ink-soft">{track.data.hook ?? track.data.tagline}</span>
              </span>
              <span class="hidden pr-1.5 font-display font-bold text-ink sm:block" aria-hidden="true">Start →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="amb-h" class="on-dark bg-ink px-4 py-14 text-white sm:px-6 lg:py-20">
    <div class="mx-auto grid max-w-site gap-10 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-6">
        <p class="font-display text-small font-bold text-glow">For high schoolers, grades 9-12</p>
        <h2 id="amb-h" class="mt-3 text-[clamp(2rem,4.4vw,3.25rem)] leading-[1.1]">Become an ARK ambassador and bring these lessons to your school.</h2>
        <p class="mt-4 max-w-[30em] text-[1.125rem] text-white/80 sm:text-[1.25rem]">Ambassadors run ARK workshops for other students at their own school, or in their community. We train you and give you everything you need to run a session.</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={AMBASSADOR_HREF} class={cn(buttonVariants({ variant: "accent", size: "lg" }), "justify-between gap-6")}>Become an ambassador <span aria-hidden="true">→</span></a>
          <a href="/get-involved" class={buttonVariants({ variant: "outline-light", size: "lg" })}>Other ways to help</a>
        </div>
      </div>
      <dl class="self-end border-t-2 border-white lg:col-span-5 lg:col-start-8">
        {ambassador.map(([n, title, body]) => (
          <div class="grid gap-1 border-b border-white/25 py-4 sm:grid-cols-[150px_1fr] sm:gap-4">
            <dt class="font-display text-[1.625rem] font-bold leading-tight">{n}</dt>
            <dd class="text-white/80"><b class="block font-display text-white">{title}</b>{body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section aria-labelledby="trust-h" class="px-4 py-14 sm:px-6 lg:py-20">
    <div class="mx-auto max-w-site">
      <SectionHead id="trust-h" label="Why families trust it" title="Safe, free, and checked." />
      <ul class="grid grid-cols-1 border-t-2 border-ink sm:grid-cols-2 lg:grid-cols-4">
        {trust.map((t) => (
          <li class="border-b border-line py-5 sm:pr-5 lg:border-b-0 lg:border-r lg:pl-5 lg:first:pl-0 lg:last:border-r-0">
            <span class={cn("mb-3.5 block h-1.5 w-7", t.bar)} aria-hidden="true"></span>
            <h3 class="font-display text-[1.1875rem] leading-snug text-ink">{t.title}</h3>
            <p class="mt-1.5 text-ui text-ink-soft">{t.body}{t.link && <> <a href={t.link[1]} class="font-bold text-brand underline underline-offset-4">{t.link[0]}</a></>}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CredibilityStrip reviewers={reviewers} />
  <ImpactNumbers />

  <section aria-labelledby="teach-h" class="border-t border-line bg-surface-2 px-4 py-14 sm:px-6 lg:py-20">
    <div class="mx-auto grid max-w-site gap-8 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-6">
        <p class="font-display text-small font-bold text-ink-soft">For teachers</p>
        <h2 id="teach-h" class="mt-3 text-[clamp(1.625rem,3vw,2.25rem)] leading-tight text-ink">Ready for your class.</h2>
        <p class="mt-3.5 max-w-[30em] text-ui text-ink-soft">Every module comes with a facilitator guide you can print and teach from. Free, and you can see all of it without signing up.</p>
        <a href="/educators" class={cn(buttonVariants({ size: "lg" }), "mt-6 justify-between gap-6")}>Teacher resources <span aria-hidden="true">→</span></a>
      </div>
      <ol class="border-t-2 border-ink lg:col-span-5 lg:col-start-8">
        {["A printable guide for every module", "QR check-ins before and after", "A slide deck for every module"].map((t, i) => (
          <li class="grid grid-cols-[40px_1fr] border-b border-line py-3.5 font-bold text-ink"><span class="font-display text-ink-soft">0{i + 1}</span>{t}</li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
