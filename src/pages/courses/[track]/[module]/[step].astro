---
// Lesson player page for one step (brief section 7). Server-rendered: step 1 of every module is open
// to everyone; steps 2+ need a session, checked on the server in src/middleware.ts and again below.
import { render } from "astro:content";
import LessonLayout from "../../../../layouts/LessonLayout.astro";
import LessonPlayer from "../../../../components/lesson/LessonPlayer.astro";
import { lessonComponents } from "../../../../components/lesson";
import { getCourses, getModuleSteps, metaDescription, moduleHref, moduleSlug, trackHref } from "../../../../lib/courses";
import { listLearners } from "../../../../lib/accounts";
import { practiceAvailable } from "../../../../lib/practice";
export const prerender = false;

const courses = await getCourses();
const course = courses.find((c) => c.track.id === Astro.params.track);
const mod = course?.modules.find((m) => moduleSlug(m) === Astro.params.module);
const steps = course && mod ? getModuleSteps(course, mod) : [];
const index = steps.findIndex((s) => s.slug === Astro.params.step);
// Step files are named "02-how-ai-learns.mdx", so people guess or share that as the URL: send them to the real one.
const unnumbered = Astro.params.step?.replace(/^\d{2}-/, "");
if (index < 0 && unnumbered !== Astro.params.step && steps.some((s) => s.slug === unnumbered)) {
  return Astro.redirect(`${moduleHref(mod!)}/${unnumbered}`, 301);
}
if (!course || !mod || index < 0) return new Response(null, { status: 404 }); // src/middleware.ts fills in the 404 page

const signedIn = Boolean(Astro.locals.user);
// Defense in depth: the middleware already redirected signed-out requests for steps 2+.
if (index > 0 && !signedIn) return Astro.redirect(`/signin?next=${encodeURIComponent(Astro.url.pathname)}`, 302);
// A parent with no learner profile yet would have nowhere to save progress: add one first, then come back.
if (Astro.locals.user && (await listLearners(Astro.locals.user.uid)).length === 0) {
  return Astro.redirect(`/account/add-learner?next=${encodeURIComponent(Astro.url.pathname)}`, 302);
}

const step = steps[index];
// MDX components read this step's data from here, so authors can write <Check /> with no props.
Astro.locals.lesson = {
  stepId: step.id,
  moduleId: mod.id,
  track: course.track.id,
  vocabulary: mod.data.vocabulary,
  questions: step.entry.data.questions,
  scenario: step.entry.data.scenario,
  sort: step.entry.data.sort,
  practiceHref: step.entry.data.practice && practiceAvailable() ? `/practice?step=${mod.id}/${step.slug}` : undefined,
};
const { Content } = await render(step.entry);
// Islands get plain step info only, not the whole content entry.
const stepRefs = steps.map(({ entry: _entry, ...ref }) => ref);
---

<LessonLayout title={`${step.title} · ${mod.data.title} · ARK`} description={metaDescription(mod.data.summary)}>
  <LessonPlayer
    track={{ id: course.track.id, title: course.track.data.title, href: trackHref(course.track) }}
    module={{ title: mod.data.title, href: moduleHref(mod), status: mod.data.status }}
    steps={stepRefs}
    index={index}
    signedIn={signedIn}
    sources={step.entry.data.sources}
  >
    <Content components={lessonComponents} />
  </LessonPlayer>
</LessonLayout>
