---
// Course page (brief section 7): a white header with the course's color block, outcomes, and a syllabus accordion.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SyllabusItem from "../../../components/SyllabusItem.astro";
import { buttonVariants } from "../../../app/components/ui/button";
import { trackStyle } from "../../../app/lib/tracks";
import { cn } from "../../../app/components/ui/utils";
import { CourseStart } from "../../../app/components/lesson/CourseProgress";
import { courseTime, getCourses, getModuleSteps, moduleLite, reviewCounts, type Course } from "../../../lib/courses";
import { Check, ExternalLink, FileText } from "lucide-react";
export const prerender = true;

export async function getStaticPaths() {
  const courses = await getCourses();
  return courses.map((course) => ({ params: { track: course.track.id }, props: { course } }));
}

const { course } = Astro.props as { course: Course };
const { track, modules } = course;
const { title, grades, tagline, summary, outcomes, slides_folder_url } = track.data;
const s = trackStyle(track.id);
const time = courseTime(course);
const counts = reviewCounts(modules);
const lites = modules.map((m) => moduleLite(course, m));
const reviewLine =
  counts.reviewed === modules.length ? "Every module in this course has been reviewed by an expert."
  : counts.reviewed === 0 && counts.inReview === 0 ? `All ${modules.length} modules are drafts under expert review.`
  : `${counts.reviewed} of ${modules.length} modules reviewed so far; the rest are drafts or in review.`;
---

<BaseLayout title={`${title}, grades ${grades} | ARK courses`} description={summary}>
  <section class="border-b border-ink px-4 pt-28 sm:px-6 lg:pt-36">
    <div class="mx-auto grid max-w-site gap-6 lg:grid-cols-12">
      <div class="pb-10 lg:col-span-7 lg:pb-12">
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Courses", href: "/courses" }, { label: title }]} class="text-ink-soft" />
        <h1 class="mt-4 text-[clamp(2.375rem,5.4vw,3.75rem)] leading-[1.1] text-ink">{title}</h1>
        <p class="mt-2 font-display text-title font-bold text-ink-soft">{tagline}</p>
        <p class="mt-4 max-w-[34em] text-lesson text-ink">{summary}</p>
        <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-ui font-bold text-ink-soft">
          <li>{modules.length} modules</li>
          <li>{time}</li>
          <li>Free</li>
        </ul>
        <!-- "Start course" until progress loads (and without JavaScript); then "Resume" with a progress ring. -->
        <CourseStart client:load modules={lites} trackId={track.id as "aware" | "literate" | "fluent"} variant="ink" />
      </div>
      <div class={cn("hidden content-between p-5 lg:col-span-4 lg:col-start-9 lg:grid", s.fill)} aria-hidden="true">
        <span class="font-display text-small font-bold">Grades</span>
        <b class="font-display text-[clamp(3.5rem,7vw,6rem)] font-bold leading-[0.9] tracking-[-0.03em]">{grades.replace("-", "–")}</b>
      </div>
    </div>
    <div class={cn("-mx-4 h-3 sm:-mx-6 lg:hidden", s.bar)} aria-hidden="true"></div>
  </section>

  <div class="px-4 py-12 sm:px-6 lg:py-16">
    <div class="mx-auto grid max-w-site gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-14">
      <!-- First in source order so it sits right under the header on mobile; the right column on desktop. -->
      <aside aria-labelledby="educators-h" class="lg:col-start-2 lg:row-start-1">
        <div class="border-t-2 border-ink pt-4 lg:sticky lg:top-28">
          <h2 id="educators-h" class="text-title text-ink">For educators</h2>
          <p class="mt-2 text-ui text-ink-soft">Teaching this in class or at home? Every module has a slide deck you can present.</p>
          <ul class="mt-4 space-y-3 text-ui">
            {slides_folder_url && (
              <li>
                <a href={slides_folder_url} class="inline-flex items-center gap-2 rounded-sm font-bold text-brand underline decoration-1 underline-offset-4 hover:decoration-2">
                  <ExternalLink aria-hidden="true" className="size-4 shrink-0" />
                  <span>Slides for all {modules.length} modules<span class="sr-only"> (Google Drive folder)</span></span>
                </a>
              </li>
            )}
            <li>
              <a href="/educators" class="inline-flex items-center gap-2 rounded-sm font-bold text-brand underline decoration-1 underline-offset-4 hover:decoration-2">
                <FileText aria-hidden="true" className="size-4 shrink-0" />
                <span>Facilitator guides</span>
              </a>
            </li>
          </ul>
          <div class="mt-5 border-t border-line pt-5">
            <h3 class="font-sans text-ui font-bold text-ink">Review status</h3>
            <p class="mt-1 text-small text-ink-soft">{reviewLine}</p>
            <a href="/about#reviewers" class="mt-1 inline-block rounded-sm text-small font-bold text-brand underline decoration-1 underline-offset-4 hover:decoration-2">How we review modules</a>
          </div>
          <a href="/workshops" class={cn(buttonVariants({ variant: "outline" }), "mt-6 w-full sm:w-auto lg:w-full")}>Bring ARK to your school</a>
        </div>
      </aside>

      <div class="min-w-0 lg:col-start-1 lg:row-start-1">
        <section aria-labelledby="learn-h" class="border-t-2 border-ink pt-5">
          <h2 id="learn-h" class="text-display-sm text-ink">What you'll learn</h2>
          <ul class="mt-5 grid gap-x-8 gap-y-3 md:grid-cols-2">
            {outcomes.map((o) => (
              <li class="flex gap-3 text-ui text-ink"><Check aria-hidden="true" className="mt-0.5 size-5 shrink-0 text-ink" />{o}</li>
            ))}
          </ul>
        </section>

        <section id="syllabus" aria-labelledby="syllabus-h" class="mt-12 scroll-mt-28">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 id="syllabus-h" class="text-display-sm text-ink">Syllabus</h2>
            <p class="text-small text-ink-soft">{modules.length} modules · {time}</p>
          </div>
          <ol class="mt-5 border-t-2 border-ink">
            {modules.map((mod) => <li><SyllabusItem mod={mod} steps={getModuleSteps(course, mod)} /></li>)}
          </ol>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
