---
// Layout for plain-text pages written in MDX (src/pages/privacy.mdx, terms.mdx, accessibility.mdx).
// Frontmatter: title, description, eyebrow, lead, updated, draft (shows the legal-review banner),
// toc (lists the page's h2 headings under "On this page").
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { LEGAL_DRAFT } from "../app/lib/legal";
import { TriangleAlert } from "lucide-react";

interface Props {
  frontmatter: { title: string; description: string; eyebrow?: string; lead?: string; updated?: string; draft?: boolean; toc?: boolean };
  headings?: { depth: number; slug: string; text: string }[];
}
const { frontmatter: fm, headings = [] } = Astro.props;
const toc = fm.toc ? headings.filter((h) => h.depth === 2) : [];
---

<BaseLayout title={`${fm.title} | ARK · AI Readiness for Kids`} description={fm.description}>
  <header class="border-b border-line bg-surface-2 px-4 pb-10 pt-28 sm:px-6 lg:pb-14 lg:pt-36">
    <div class="mx-auto max-w-site">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: fm.title }]} class="mb-6 text-ink-soft" />
      {fm.eyebrow && <p class="text-small font-bold uppercase tracking-[0.14em] text-brand">{fm.eyebrow}</p>}
      <h1 class="mt-2 max-w-4xl text-display-md text-ink sm:text-display-lg">{fm.title}</h1>
      {fm.lead && <p class="mt-4 max-w-reading text-lesson text-ink-soft">{fm.lead}</p>}
      {fm.updated && <p class="mt-4 text-small text-ink-soft">Last updated: {fm.updated}</p>}
    </div>
  </header>

  <div class="px-4 py-12 sm:px-6 lg:py-16">
    {fm.draft && (
      <div role="note" class="mx-auto mb-10 flex max-w-site gap-3 rounded-xl border border-warning/40 bg-warning-soft p-4 sm:p-5">
        <TriangleAlert aria-hidden="true" className="mt-0.5 size-5 shrink-0 text-warning" />
        <div class="text-ui text-ink">
          <p class="font-bold uppercase tracking-[0.08em] text-warning">{LEGAL_DRAFT}</p>
          <p class="mt-1">This is a plain-language draft written by the ARK team for review by a lawyer. It is not final, and it is not legal advice. Notes in <span class="review-note">highlighted brackets</span> are questions for that review.</p>
        </div>
      </div>
    )}
    <div class="mx-auto grid max-w-site gap-10 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-16">
      <article class="lesson-prose doc-prose min-w-0 max-w-reading text-lesson">
        <slot />
      </article>
      {toc.length > 0 && (
        <nav aria-labelledby="toc-h" class="order-first self-start rounded-xl border border-line bg-surface p-5 lg:sticky lg:top-28 lg:order-none">
          <h2 id="toc-h" class="font-sans text-small font-bold uppercase tracking-[0.12em] text-ink-soft">On this page</h2>
          <ol class="mt-3 grid gap-1">
            {toc.map((h) => <li><a href={`#${h.slug}`} class="block rounded-sm py-1 text-ui text-ink underline decoration-line-strong decoration-1 underline-offset-4 hover:text-brand hover:decoration-brand">{h.text}</a></li>)}
          </ol>
        </nav>
      )}
    </div>
  </div>
</BaseLayout>
