# Copy to .env for local work. Never commit .env. Production values live only in Netlify's
# environment variables (docs/SETUP_FIREBASE.md). Keep the total size of all variables under 4 KB.

# Public (safe to expose; they end up in the browser):
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_RECAPTCHA_SITE_KEY=

# SECRET (server only; from the Firebase service account key):
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
