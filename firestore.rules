rules_version = '2';

// ARK's browser code never reads or writes Firestore (brief section 8.2). Every read and write goes
// through the site's server routes with firebase-admin, which checks ownership first. So the rules
// deny all client access, for everyone, to everything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
