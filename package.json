{
  "name": "ark-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ARK (AI Readiness for Kids): free K-12 AI literacy course platform",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 5180",
    "build": "astro build && node scripts/check-dist.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "check": "astro check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "pretest:visual": "npm run build",
    "test:visual": "playwright test tests/visual.spec.ts",
    "pretest:a11y": "npm run build",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "pretest": "npm run build && npm run check:contrast",
    "test": "playwright test"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.2",
    "@astrojs/netlify": "8.2.6",
    "@astrojs/react": "7.0.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.55.0",
    "tailwind-merge": "3.2.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "6.0.3"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
