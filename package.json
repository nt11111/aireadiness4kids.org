{
  "name": "ark-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ARK (AI Readiness for Kids): free K-12 AI literacy course platform",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 5180",
    "build": "astro build && node scripts/check-dist.mjs",
    "build:test": "node scripts/build-test.mjs",
    "emulators": "firebase emulators:start --project demo-ark --only auth,firestore",
    "preview": "node scripts/test-server.mjs",
    "check": "astro check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test": "npm run check:contrast && npm run build:test && firebase emulators:exec --project demo-ark --only auth,firestore \"playwright test\"",
    "test:visual": "npm run build:test && firebase emulators:exec --project demo-ark --only auth,firestore \"playwright test tests/visual.spec.ts\"",
    "test:a11y": "npm run build:test && firebase emulators:exec --project demo-ark --only auth,firestore \"playwright test tests/a11y.spec.ts tests/lesson.spec.ts\"",
    "test:security": "npm run build:test && firebase emulators:exec --project demo-ark --only auth,firestore \"playwright test tests/security.spec.ts tests/rules.spec.ts tests/auth.spec.ts\""
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/netlify": "8.2.6",
    "@astrojs/react": "7.0.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.55.0",
    "tailwind-merge": "3.2.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/node": "11.1.6",
    "@axe-core/playwright": "4.13.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "6.0.3"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
